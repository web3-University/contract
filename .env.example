# ==================== 网络配置 ====================

# Sepolia 测试网
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID

# Polygon Mumbai 测试网
MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/YOUR_INFURA_KEY
MUMBAI_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID

# Avalanche Fuji 测试网
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID

# ==================== 账户配置 ====================

# 部署账户私钥 (不要提交到 Git!)
PRIVATE_KEY=your_private_key_here

# ==================== 合约配置 ====================

# NFT 元数据基础 URI
BASE_TOKEN_URI=https://api.web3university.com/metadata/

# 已部署合约地址 (部署后填写)
ORACLE_ADDRESS=
NFT_ADDRESS=

# CourseDAO 依赖合约地址
YD_TOKEN_ADDRESS=
COURSE_CONTRACT_ADDRESS=

# CourseDAO 合约地址 (部署后填写，用于交互脚本)
COURSE_DAO_ADDRESS=

# ==================== Chainlink Functions 配置 ====================

# Chainlink Functions Gas Limit
GAS_LIMIT=300000

# API 密钥 (用于 Chainlink Functions secrets)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# ==================== 区块链浏览器 API Key ====================

# Etherscan API Key (用于合约验证)
ETHERSCAN_API_KEY=your_etherscan_api_key

# PolygonScan API Key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Snowtrace API Key (Avalanche)
SNOWTRACE_API_KEY=your_snowtrace_api_key

# ==================== 其他配置 ====================

# 是否在部署后自动验证合约
VERIFY=true

# 后端 API 基础 URL
API_BASE_URL=https://api.web3university.com
